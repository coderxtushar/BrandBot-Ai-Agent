# Copy to deploy/secrets.env (git ignores it) and fill in. deploy/cloudrun.sh loads it automatically.
# Values are stored in Google Secret Manager on the first deploy; later runs leave existing secrets alone.

PROJECT_ID=
# Put the API in the same region as the database: every request makes several database round trips.
REGION=asia-south1
WEB_URL=https://your-app.vercel.app
# Publish due posts every minute. On Neon's free plan use every 15 minutes, or the database never sleeps
# and uses up the monthly compute hours.
TICK_SCHEDULE=* * * * *

# Neon: Dashboard > Connect > turn "Connection pooling" OFF and copy the string as is (sslmode=require is fine).
DATABASE_URL=
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Optional
LANGSMITH_API_KEY=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
