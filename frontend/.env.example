# The web app proxies /api/* to the Brand Bot API (see next.config.ts). Read at build time.
API_ORIGIN=http://localhost:8000

# Optional: call the API directly instead of through /api (it must then share a parent domain with this app,
# e.g. app.example.com + api.example.com, so the session cookie is first-party).
# NEXT_PUBLIC_API_URL=https://api.example.com
