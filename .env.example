# Copy to .env and fill in.
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_REVIEW_MODEL=gemini-3.5-flash
# MAX_REVISIONS=2
# SEARCH_DEPTH=basic
# CORS_ORIGINS=["http://localhost:5173"]

# Dev: canned output, no API keys needed
# DEMO_MODE=true

# Database (default: local SQLite file)
# DATABASE_URL=postgresql+asyncpg://brandbot:brandbot@localhost:5432/brandbot
# DB_AUTO_CREATE=false   # use `alembic upgrade head` instead
