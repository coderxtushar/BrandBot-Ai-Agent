# Copy to .env and fill in.
GOOGLE_API_KEY=
TAVILY_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_REVIEW_MODEL=gemini-3.5-flash
# MAX_REVISIONS=2
# SEARCH_DEPTH=basic
# CORS_ORIGINS=["http://localhost:3000"]

# Dev: canned output, no API keys needed
# DEMO_MODE=true

# Database (default: local SQLite file)
# DATABASE_URL=postgresql+asyncpg://brandbot:brandbot@localhost:5432/brandbot
# DB_AUTO_CREATE=false   # use `alembic upgrade head` instead

# Accounts & security
# SECRET_KEY=<long random string>      # encrypts platform tokens; required in production
# COOKIE_SECURE=true                   # production (HTTPS)

# Public URLs (OAuth callbacks + image URLs that Instagram/Threads fetch)
# API_PUBLIC_URL=http://localhost:8000
# WEB_URL=http://localhost:3000

# Publishing: create developer apps and set the callback URL to
#   {API_PUBLIC_URL}/connections/{platform}/callback   (platform = linkedin | x | threads | instagram)
# LINKEDIN_CLIENT_ID= / LINKEDIN_CLIENT_SECRET=      ("Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect")
# LINKEDIN_API_VERSION=202607
# X_CLIENT_ID= / X_CLIENT_SECRET=                    (OAuth 2.0, type "Web App")
# THREADS_APP_ID= / THREADS_APP_SECRET=
# INSTAGRAM_APP_ID= / INSTAGRAM_APP_SECRET=          (Instagram API with Instagram Login; Business/Creator accounts)
# SCHEDULER_ENABLED=true
# METRICS_REFRESH_HOURS=6        # how often to re-read stats of recent posts
# METRICS_MAX_AGE_DAYS=30        # stop tracking stats this long after publishing
# Threads and Instagram stats need the insights permissions (threads_manage_insights,
# instagram_business_manage_insights); reconnect accounts connected before step 9.

# --- Production (step 10) -------------------------------------------------------------------------
# ENVIRONMENT=production       # refuses to start without a real SECRET_KEY and COOKIE_SECURE=true
# LOG_FORMAT=json              # one JSON object per line (Cloud Logging)
# GOOGLE_CLOUD_PROJECT=        # links log lines to Cloud Trace
# TRUSTED_PROXY_HOPS=0         # proxies that append X-Forwarded-For: Cloud Run 1, Vercel -> Cloud Run 2

# Media: local disk (MEDIA_DIR), a Google Cloud Storage bucket (gcs) or the database (db, for Render's free plan)
# MEDIA_BACKEND=local
# GCS_BUCKET=

# Scheduled posts on Cloud Run: turn the in-process scheduler off and have Cloud Scheduler
# POST /internal/tick every minute with "Authorization: Bearer $CRON_SECRET".
# SCHEDULER_ENABLED=false
# CRON_SECRET=
# MIGRATE_ON_START=false       # Docker image: run `alembic upgrade head` before starting (single-instance hosts)

# Rate limits ("count/period", comma separated). Shared by every API instance via the database.
# RATE_LIMITS_ENABLED=true
# RATE_LIMIT_RUNS=10/hour,40/day
# RATE_LIMIT_REWRITES=40/hour,200/day
# RATE_LIMIT_IMAGES=20/hour,60/day
# RATE_LIMIT_LOGIN=10/5minutes
# RATE_LIMIT_SIGNUP=5/hour

# Tracing: every run, rewrite and image call in LangSmith, tagged with user, brand and run ids
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=brand-bot
